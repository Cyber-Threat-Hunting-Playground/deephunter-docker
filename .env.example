# DeepHunter Docker Environment Configuration
# Copy this file to .env and adjust the values as needed

# Docker Image Configuration
# For local builds, leave as-is. To pull from Docker Hub instead of building:
# DEEPHUNTER_IMAGE=cyberthreatplayground/deephunter:2.5
DEEPHUNTER_IMAGE=deephunter:latest

# For pushing to a registry via build.sh (optional, leave empty for local-only):
# DOCKER_REGISTRY=cyberthreatplayground

# GitHub Source Repository
# Change these to build from a fork or a different release.
GITHUB_REPO=Cyber-Threat-Hunting-Playground/deephunter
DEEPHUNTER_VERSION=2.5

# MariaDB Configuration
# Must be non-empty. A line like MARIADB_ROOT_PASSWORD= (nothing after =) breaks auth and init scripts.
# Use quotes if the password has shell-special characters, e.g. MARIADB_ROOT_PASSWORD='YourSecureRootPassword123!'
MARIADB_ROOT_PASSWORD=YourSecureRootPassword123!
MARIADB_DATABASE=deephunter
MARIADB_USER=deephunter
MARIADB_PASSWORD=Awes0meP4ssW0rd

# Redis Configuration (optional)
REDIS_PASSWORD=

# DeepHunter Configuration
DEEPHUNTER_PORT=9000
DEEPHUNTER_HOST=localhost

# Optional: Timezone
TZ=UTC

# Optional: Backup Configuration
BACKUP_RETENTION_DAYS=30

# Optional: Database Data Retention
# Max retention (in days). By default 90 days (3 months).
DB_DATA_RETENTION=90

# Optional: Scheduled Orchestrator (cron)
# Set to true to enable automatic execution of the orchestrator script.
# This is NOT mandatory; leave false to run the orchestrator manually.
ENABLE_CRON=false
# Cron schedule expression (evaluated in the TZ timezone, default UTC).
# Default: daily at 10:30 AM UTC.  Format: minute hour day month weekday
CRON_SCHEDULE="30 10 * * *"

# Optional: Database Administration UI (Adminer)
# Adminer provides a lightweight web UI for managing MariaDB.
# To enable, uncomment COMPOSE_PROFILES below. A dedicated dbadmin account
# is created on first MariaDB initialization when both ADMINER_DB_USER and
# ADMINER_DB_PASSWORD are set.
# COMPOSE_PROFILES=adminer
ADMINER_PORT=8080
ADMINER_DB_USER=dbadmin
ADMINER_DB_PASSWORD=DbAdm1nP4ssW0rd!

# Optional: Resource Limits (uncomment to enable)
# MARIADB_MAX_CONNECTIONS=500
# MARIADB_BUFFER_POOL=1G
# REDIS_MAX_MEMORY=512mb
