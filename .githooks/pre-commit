#!/bin/bash
# Pre-commit hook to validate Docker and shell scripts
# and scan staged files for forbidden strings.
#
# Activate:  git config core.hooksPath .githooks
#        or: make setup-hooks

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
PATTERNS_FILE="$REPO_ROOT/.githooks/forbidden-patterns.txt"

echo "Running pre-commit checks..."

# Check if docker-compose.yml is valid
if command -v docker &> /dev/null; then
    if [ -f "docker-compose.yml" ]; then
        echo "✓ Validating docker-compose.yml..."
        docker compose config --quiet || docker-compose config --quiet || {
            echo "✗ docker-compose.yml validation failed"
            exit 1
        }
    fi
fi

# Check if Dockerfile exists and has basic validation
if [ -f "Dockerfile" ]; then
    echo "✓ Checking Dockerfile..."
    if ! grep -q "FROM" Dockerfile; then
        echo "✗ Dockerfile missing FROM instruction"
        exit 1
    fi
fi

# Check for common issues in scripts
for script in scripts/*.sh build.sh; do
    if [ -f "$script" ]; then
        # Check for executable permission
        if [ ! -x "$script" ]; then
            echo "⚠ Warning: $script is not executable"
        fi
        
        # Check for shebang
        if ! head -n1 "$script" | grep -q "^#!/"; then
            echo "✗ $script missing shebang"
            exit 1
        fi
    fi
done

# ---------------------------------------------------------------------------
# Forbidden-string scan on staged files
# ---------------------------------------------------------------------------
if [ ! -f "$PATTERNS_FILE" ]; then
    echo "⚠ Warning: $PATTERNS_FILE not found — skipping forbidden-string check."
    echo "  Copy the example:  cp .githooks/forbidden-patterns.txt.example .githooks/forbidden-patterns.txt"
else
    PATTERNS=()
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"        # strip inline comments
        line="${line#"${line%%[![:space:]]*}"}"  # trim leading whitespace
        line="${line%"${line##*[![:space:]]}"}"  # trim trailing whitespace
        [ -z "$line" ] && continue
        PATTERNS+=("$line")
    done < "$PATTERNS_FILE"

    if [ "${#PATTERNS[@]}" -eq 0 ]; then
        echo "⚠ Warning: no patterns in $PATTERNS_FILE — skipping forbidden-string check."
    else
        echo "✓ Scanning staged files for forbidden strings..."
        STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)
        FOUND=0

        for file in $STAGED_FILES; do
            [ -f "$file" ] || continue
            for pattern in "${PATTERNS[@]}"; do
                # -I skip binary, -i case-insensitive, -F fixed-string, -n line numbers
                MATCHES=$(grep -niFI -- "$pattern" "$file" 2>/dev/null || true)
                if [ -n "$MATCHES" ]; then
                    if [ "$FOUND" -eq 0 ]; then
                        echo ""
                        echo "✗ Forbidden string(s) detected in staged files:"
                    fi
                    FOUND=1
                    while IFS= read -r match; do
                        echo "  $file:$match  [pattern: $pattern]"
                    done <<< "$MATCHES"
                fi
            done
        done

        if [ "$FOUND" -ne 0 ]; then
            echo ""
            echo "Commit blocked. Remove or replace the flagged strings and try again."
            echo "To edit the pattern list: $PATTERNS_FILE"
            exit 1
        fi
        echo "✓ No forbidden strings found."
    fi
fi

echo "✓ All checks passed!"
