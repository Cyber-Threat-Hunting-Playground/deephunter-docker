#!/bin/bash
# Pre-push hook — safety net that scans the diff of commits about to be
# pushed for forbidden strings defined in .githooks/forbidden-patterns.txt.
#
# Activate:  git config core.hooksPath .githooks
#        or: make setup-hooks

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
PATTERNS_FILE="$REPO_ROOT/.githooks/forbidden-patterns.txt"
ZERO_SHA="0000000000000000000000000000000000000000"

if [ ! -f "$PATTERNS_FILE" ]; then
    echo "⚠ pre-push: $PATTERNS_FILE not found — skipping forbidden-string check."
    exit 0
fi

PATTERNS=()
while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -z "$line" ] && continue
    PATTERNS+=("$line")
done < "$PATTERNS_FILE"

if [ "${#PATTERNS[@]}" -eq 0 ]; then
    exit 0
fi

DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's@^refs/remotes/origin/@@') || DEFAULT_BRANCH="main"

FOUND=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue

    if [ "$local_sha" = "$ZERO_SHA" ]; then
        # Deleting a remote branch — nothing to scan.
        continue
    fi

    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        # New branch: diff against merge-base with the default branch.
        BASE=$(git merge-base "$DEFAULT_BRANCH" "$local_sha" 2>/dev/null || echo "")
        if [ -z "$BASE" ]; then
            RANGE="$local_sha"
        else
            RANGE="$BASE..$local_sha"
        fi
    else
        RANGE="$remote_sha..$local_sha"
    fi

    DIFF_OUTPUT=$(git diff "$RANGE" -- 2>/dev/null || true)
    [ -z "$DIFF_OUTPUT" ] && continue

    for pattern in "${PATTERNS[@]}"; do
        MATCHES=$(echo "$DIFF_OUTPUT" | grep -niF -- "$pattern" 2>/dev/null || true)
        if [ -n "$MATCHES" ]; then
            if [ "$FOUND" -eq 0 ]; then
                echo ""
                echo "✗ Forbidden string(s) detected in commits about to be pushed:"
            fi
            FOUND=1
            echo "  ref: $local_ref  range: $RANGE  pattern: $pattern"
            echo "$MATCHES" | head -5 | while IFS= read -r m; do
                echo "    $m"
            done
            MATCH_COUNT=$(echo "$MATCHES" | wc -l)
            if [ "$MATCH_COUNT" -gt 5 ]; then
                echo "    ... and $((MATCH_COUNT - 5)) more matches"
            fi
        fi
    done
done

if [ "$FOUND" -ne 0 ]; then
    echo ""
    echo "Push blocked. Remove or replace the flagged strings and force-amend/rebase before pushing."
    echo "To edit the pattern list: $PATTERNS_FILE"
    exit 1
fi

exit 0
